export APP_NAME="AI Workspace Proxy"
export APP_BIND_ADDR=":80"
export APP_BASE_URL="http://localhost"

export GOOGLE_WORKSPACE_CLIENT_ID=""
export GOOGLE_WORKSPACE_CLIENT_SECRET=""

# 32 raw bytes, 64 hex chars, or base64-encoded 32 bytes.
export PROXY_ENCRYPTION_KEY="replace_me_with_64_hexadecimal_chars_randomly_generated"

# Only Google accounts belonging to these comma-separated domains will be allowed to login on the proxy dashboard.
export ALLOWED_EMAIL_DOMAINS="yourdomain.com,gmail.com"

# Only the email address identified below will have access to the admin dashboard
export ADMIN_EMAILS="adminemail@yourdomain.com"

export DB_PATH="./db/ai_workspace_proxy.sqlite3"
export DENIED_LOG_PATH="./logs/denied.log"
export SESSION_COOKIE_NAME="ai_workspace_proxy_session"
export COOKIE_SECURE="false"
export HTTP_CLIENT_TIMEOUT_SEC="30"
export SESSION_TTL_HOURS="168"

# This variable limits the size of requests. This impact, for example, the maximum attachments size in emails
export MAX_REQUEST_BODY_BYTES="30000000"
